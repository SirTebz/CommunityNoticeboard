@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<section class="hero-panel"><div><p class="eyebrow">YOUR COMMUNITY</p><h1>Welcome back, @User.Identity?.Name?.Split('@')[0]</h1><p>Here is a live view of conversations and connections in your community.</p></div><a asp-controller="Posts" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create a post</a></section>
<section class="stats-grid">
    <article class="stat-card"><span class="stat-icon primary"><i class="bi bi-collection"></i></span><span>Community posts</span><strong>@Model.TotalPosts</strong><small>Published conversations</small></article>
    <article class="stat-card"><span class="stat-icon success"><i class="bi bi-people"></i></span><span>Community members</span><strong>@Model.TotalMembers</strong><small>Registered neighbours</small></article>
    <article class="stat-card"><span class="stat-icon violet"><i class="bi bi-chat-square-text"></i></span><span>Comments</span><strong>@Model.TotalComments</strong><small>Community responses</small></article>
    <article class="stat-card"><span class="stat-icon amber"><i class="bi bi-pin-angle"></i></span><span>Pinned updates</span><strong>@Model.PinnedAnnouncements</strong><small>Important notices</small></article>
</section>
<section class="content-grid"><div class="surface"><div class="surface-heading"><div><p class="eyebrow">LATEST</p><h2>Recent conversations</h2></div><a asp-controller="Posts" asp-action="Index" class="text-link">View feed <i class="bi bi-arrow-right"></i></a></div>@if (Model.RecentPosts.Any()) { foreach (var post in Model.RecentPosts) { <partial name="~/Views/Posts/_PostCard.cshtml" model="post" /> } } else { <div class="empty-state"><i class="bi bi-chat-square"></i><p>No conversations yet.</p></div> }</div><aside class="side-stack"><div class="surface"><p class="eyebrow">YOUR ACTIVITY</p><div class="activity-row"><span><i class="bi bi-pencil-square"></i> My posts</span><strong>@Model.MyPosts</strong></div><div class="activity-row"><span><i class="bi bi-chat"></i> My comments</span><strong>@Model.MyComments</strong></div></div><div class="surface"><p class="eyebrow">POPULAR TOPICS</p>@foreach (var category in Model.Categories) { <div class="topic-row"><span class="category-dot"></span>@category.Name <small>@category.Count posts</small></div> }</div></aside></section>
