@model DashboardViewModel
@{ ViewData["Title"] = "Admin dashboard"; }
<section class="hero-panel admin-hero"><div><p class="eyebrow">ADMINISTRATION</p><h1>Community oversight</h1><p>Monitor content, member activity and the conversations that need attention.</p></div><a asp-controller="Admin" asp-action="Members" class="btn btn-light"><i class="bi bi-people"></i> Manage members</a></section>
<section class="stats-grid"><article class="stat-card"><span class="stat-icon primary"><i class="bi bi-people"></i></span><span>Members</span><strong>@Model.TotalMembers</strong><small>All registered accounts</small></article><article class="stat-card"><span class="stat-icon success"><i class="bi bi-collection"></i></span><span>Posts</span><strong>@Model.TotalPosts</strong><small>Across all categories</small></article><article class="stat-card"><span class="stat-icon violet"><i class="bi bi-chat-square-text"></i></span><span>Comments</span><strong>@Model.TotalComments</strong><small>Community engagement</small></article><article class="stat-card"><span class="stat-icon amber"><i class="bi bi-pin-angle"></i></span><span>Pinned</span><strong>@Model.PinnedAnnouncements</strong><small>Important announcements</small></article></section>
<section class="content-grid"><div class="surface"><div class="surface-heading"><div><p class="eyebrow">CONTENT</p><h2>Recent posts</h2></div><a asp-controller="Posts" asp-action="Index" class="text-link">Moderate content <i class="bi bi-arrow-right"></i></a></div><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Post</th><th>Author</th><th>Category</th><th>Engagement</th><th></th></tr></thead><tbody>@foreach (var post in Model.RecentPosts) { <tr><td><a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">@post.Title</a>@if(post.IsPinned){<span class="role-chip ms-2">Pinned</span>}</td><td>@post.User.UserName</td><td><span class="category-badge">@post.Category</span></td><td>@post.Comments.Count comments</td><td><a class="btn btn-icon" asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" aria-label="Review @post.Title"><i class="bi bi-arrow-up-right"></i></a></td></tr>}</tbody></table></div></div><aside class="side-stack"><div class="surface"><p class="eyebrow">CATEGORY MIX</p>@foreach (var category in Model.Categories) { <div class="topic-row"><span class="category-dot"></span>@category.Name <small>@category.Count posts</small></div> }</div><div class="surface"><p class="eyebrow">ADMIN TOOLS</p><a class="admin-tool" asp-controller="Admin" asp-action="Members"><i class="bi bi-people"></i><span>Member management<small>Review member activity</small></span><i class="bi bi-chevron-right"></i></a><a class="admin-tool" asp-controller="Posts" asp-action="Index"><i class="bi bi-pin-angle"></i><span>Content moderation<small>Pin, edit or remove posts</small></span><i class="bi bi-chevron-right"></i></a></div></aside></section>
