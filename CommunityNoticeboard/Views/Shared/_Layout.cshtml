<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Communio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Posts" asp-action="Index"><span class="brand-mark"><i class="bi bi-chat-square-heart-fill"></i></span><span>Communio</span></a>
            <nav class="sidebar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <p class="nav-label">Workspace</p>
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                }
                <p class="nav-label">Community</p>
                <a class="nav-link" asp-controller="Posts" asp-action="Index"><i class="bi bi-collection"></i> Community feed</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Posts" asp-action="Create"><i class="bi bi-plus-circle"></i> Create post</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <p class="nav-label">Administration</p>
                    <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-check"></i> Admin dashboard</a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Members"><i class="bi bi-people"></i> Member management</a>
                }
            </nav>
            <div class="sidebar-bottom"><small>Community connection,<br />made simple.</small></div>
        </aside>
        <div class="app-content">
            <header class="topbar">
                <button class="btn btn-icon d-lg-none" type="button" id="sidebarToggle" aria-label="Toggle navigation"><i class="bi bi-list"></i></button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-actions"><partial name="_LoginPartial" /></div>
            </header>
            <main class="main-content">
                @if (TempData["SuccessMessage"] != null)
                { <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["ErrorMessage"] != null)
                { <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
