@using Microsoft.AspNetCore.Identity
@using CommunityNoticeboard.Models
@inject SignInManager<ApplicationUser> SignInManager
@if (SignInManager.IsSignedIn(User))
{
    <span class="user-chip"><span class="avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper())</span><span class="d-none d-sm-inline">@User.Identity?.Name</span>@if (User.IsInRole("Admin")) { <span class="role-chip">Admin</span> }</span>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Posts")"><button type="submit" class="btn btn-icon" aria-label="Log out"><i class="bi bi-box-arrow-right"></i></button></form>
}
else
{
    <a class="btn btn-quiet" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Join community</a>
}
